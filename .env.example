# Copy this file to ".env" (same folder) and fill in your own values.
# Never share your .env file: it contains your password.

# Your guild's SWGT address. Open your guild's SWGT site in your browser
# and copy the address from the address bar.
SWGT_URL=https://yourguild.swgt.io

# The login you use on the SWGT website (not your Summoners War login).
SWGT_USER=your_swgt_username
# Keep the quotes, especially if the password has spaces or # characters.
SWGT_PASSWORD="your_swgt_password"
