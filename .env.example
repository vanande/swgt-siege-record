# Copy this file to ".env" (same folder) and fill in your own values.
# Never share your .env file: it contains your password.

# The part before ".swgt.io" in your guild's SWGT address.
# Example: https://reisfarmer.swgt.io  ->  reisfarmer
SWGT_SUBDOMAIN=yourguild

SWGT_USER=your_swgt_username
# Put the password in quotes if it contains spaces or # characters.
SWGT_PASSWORD="your_swgt_password"
